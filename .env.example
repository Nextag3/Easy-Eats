# Copie para .env (que não vai para o git) e preencha.

# Usuário do Docker Hub dono das imagens (<usuario>/easy-eats-backend etc.).
DOCKERHUB_USER=
# Versão das imagens publicadas/baixadas.
TAG=latest

# Obrigatório. Chave Base64 para assinar os tokens JWT. Gere uma com:
#   openssl rand -base64 64 | tr -d '\r\n'
JWT_SECRET=

# Porta no navegador: http://localhost:8000
FRONT_PORT=8000

# Usuário e senha do Postgres do container (não é o Postgres da sua máquina).
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Só para quem vai fazer build: caminho do repositório do backend, se ele não
# estiver clonado ao lado deste.
# API_PATH=../Easy-Eats-Api

# Opcional: chaves do Stripe Connect. Sem elas, só o pagamento online não
# funciona.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
